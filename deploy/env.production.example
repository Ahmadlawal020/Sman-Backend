# Copy this to .env in the sman-backend directory on the EC2 box and fill
# in the blanks. This is the MINIMUM needed to go live — see .env.example
# in the repo root for every other optional setting (WhatsApp, push
# notifications, etc.) if/when those get turned on.

NODE_ENV=production
PORT=5002

# The SAME live database Django's own DATABASE_URL points at. This exact
# value is already known-good (used and verified earlier in this repo's own
# setup) — copy LIVE_DATABASE_URL's value out of this repo's local .env:
#   postgresql://soroman_user:<password>@35.180.19.138:5432/soroman_db
DATABASE_URL=

# Generate two DIFFERENT random secrets — run this twice, use a different
# output for each line:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
STAFF_ACCESS_TOKEN_SECRET=
CUSTOMER_ACCESS_TOKEN_SECRET=

# The portal and API live on different subdomains, so the refresh cookie
# needs SameSite=none (this also forces it to require HTTPS, which nginx
# already provides).
COOKIE_SAMESITE=none

# Every real frontend origin that will call this API, comma-separated,
# no trailing slashes:
CORS_ALLOWED_ORIGINS=https://ordersoroman.com

CLIENT_URL=https://ordersoroman.com

# Same accounts/credentials Django's own .env already uses for these —
# ask whoever manages Django's .env for the real values:
RESEND_API_KEY=
EMAIL_FROM=Soroman Energy <orders@soromannl.com>
TERMII_API_KEY=
TERMII_SENDER_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack is disabled in this codebase (manual bank deposits only, see
# services/payment.service.js) — these are never actually called, any
# placeholder value is fine:
PAYSTACK_SECRET_KEY=sk_live_unused
PAYSTACK_PUBLIC_KEY=pk_live_unused
