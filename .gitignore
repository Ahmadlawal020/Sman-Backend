node_modules/
.env
.env.backup-*
logs/
*.log

# Database dumps. These carry real customer data (names, phone numbers,
# balances) and run to tens of megabytes — they belong on disk, not in git.
*.dump
*.sql
!db/migrations.legacy-neon/*.sql
# Real migrations for the sman schema (Sman-Backend-owned tables, never
# Django's) — small, DDL-only, meant to be committed like any other
# migration, unlike the data dumps above.
!db/migrations.sman/*.sql
# Schema-only (no rows) ground truth for the live DB cutover — small and
# meant to be committed and reviewed, unlike the data dumps above.
!docs/live_schema.sql

# Scratch output from `drizzle-kit introspect`. Regenerable, never imported.
.drizzle-introspect/
AUDIT.md
PACKAGES.md
CUSTOMER_PORTAL_PLAN.md
SCHEMA_PLAN.md
Soroman_Auth_Comparison.pdf
API_TESTING.md
HARDENING_PLAN.md
WHATSAPP_PLAN.md
WHATSAPP_ENGINE_PLAN.md
PR2_PLAN.md
.claude/
