{
  "name": "dashboard-server",
  "version": "2.0.0",
  "description": "Soroman Dashboard Backend - Logistics & Fleet Management",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server",
    "dev": "nodemon server",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "test": "NODE_ENV=test RATE_LIMIT_DISABLED=true OTP_DEV_MODE=true OTP_DEV_CODE=000000 OTP_DAILY_SEND_CAP=1000000 OTP_REGISTER_PER_IP=1000000 OTP_LOGIN_PER_IP=1000000 node --test --test-concurrency=1 --test-force-exit \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
