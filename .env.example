# =============================================================================
# Soroman Dashboard Server — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/soroman_dashboard?sslmode=require

# Access-token signing secrets, one per realm.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# They MUST differ. A shared secret means a customer token verifies as a staff
# token anywhere an audience check is missed. Boot fails if they match.
#
# STAFF_ACCESS_TOKEN_SECRET falls back to the legacy ACCESS_TOKEN_SECRET.
# CUSTOMER_ACCESS_TOKEN_SECRET has no fallback and is REQUIRED in production;
# outside production one is derived from the staff secret, with a warning.
STAFF_ACCESS_TOKEN_SECRET=your_staff_access_token_secret_here
CUSTOMER_ACCESS_TOKEN_SECRET=your_customer_access_token_secret_here

# REFRESH_TOKEN_SECRET is no longer used. Refresh tokens are opaque random
# strings stored as salted-domain SHA-256 hashes, so there is nothing to sign.

# Refresh-cookie SameSite policy. "strict" blocks the cross-site POST that CSRF
# depends on and is correct when the portal shares a registrable domain with
# the API. A portal on a genuinely different domain needs "none", which
# requires HTTPS — the CSRF double-submit then becomes the primary defence.
COOKIE_SAMESITE=strict

# Phone handling. Bare local numbers (08012345678) are resolved against this
# country; international customers must supply a country code.
DEFAULT_PHONE_COUNTRY=NG

# Comma-separated ISO country codes permitted to receive an OTP.
# Unset (or blank) means every country is allowed. Set this to the markets you
# actually serve before launch — unrestricted international OTP is the classic
# SMS-pumping / toll-fraud surface.
# OTP_ALLOWED_COUNTRIES=NG,GH

# Hard daily ceiling on OTP sends. Turnstile reduces volume; only this bounds
# it, and unlike a captcha it also covers retry loops and bad deploys.
OTP_DAILY_SEND_CAP=500

# Cloudflare Turnstile. Optional in development (the check is skipped when
# unset) so the backend can ship before the frontend renders the widget.
# REQUIRED in production — the server refuses to boot without it.
# TURNSTILE_SECRET_KEY=

# OTP rate limits. Per-phone is the precise control. Per-IP is a loose backstop
# on purpose: Nigerian carriers use CGNAT, so many customers share one address.
# OTP_REGISTER_PER_PHONE=2
# OTP_REGISTER_PER_IP=30
# OTP_LOGIN_PER_PHONE=3
# OTP_LOGIN_PER_IP=60

# Development-only OTP bypass: a fixed code and no SMS dispatch. Verification
# still runs in full. Both must be set. The server refuses to boot with this on
# in production or alongside a live Paystack key. Never ship these.
# OTP_DEV_MODE=true
# OTP_DEV_CODE=000000

# Server
PORT=5002

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Resend) — required for password setup emails
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Soroman Dashboard <noreply@yourdomain.com>
CLIENT_URL=http://localhost:3000

# Paystack — required for virtual account generation
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Termii — required for SMS notifications
TERMII_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=SOROMAN
